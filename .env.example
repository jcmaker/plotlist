# Supabase
# Get these from your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# TMDB (The Movie Database)
# Get your API key from: https://www.themoviedb.org/settings/api
# NOTE: The read-only TMDB API key is safe to expose in mobile apps.
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-api-key-here

# Share page base URL
# Used to build share links: ${EXPO_PUBLIC_SHARE_BASE_URL}/share/:handle/:slug
# Local dev: http://localhost:8081 (or your LAN IP, e.g. http://192.168.1.10:8081)
# Production: https://your-domain.com
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:8081
