# Supabase
# Get these from your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# TMDB (The Movie Database)
# Get your API key from: https://www.themoviedb.org/settings/api
# The read-only TMDB API key is safe to expose in mobile apps.
# Supports both v3 API key and v4 Read Access Token (JWT starting with "eyJ").
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-api-key-here

# Share page base URL
# Used to build share links: ${EXPO_PUBLIC_SHARE_BASE_URL}/share/:handle/:slug
#
# LOCAL DEV (default if unset):
#   http://localhost:8081
#   Links work only on your own device. The app will warn you when sharing a
#   local link so you don't accidentally send it to someone else.
#
# LAN TESTING (same Wi-Fi network):
#   http://192.168.x.x:8081   — find your IP with `ipconfig getifaddr en0`
#   Links work for anyone on the same network. Still not publicly shareable.
#
# EXTERNAL SHARING (real users):
#   https://your-deployed-domain.com
#   Must be a publicly reachable HTTPS URL. Deploy Expo web output or use a
#   tunnel (e.g. `npx expo start --tunnel`) during development.
#
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:8081
